{
  "name": "critical-alert-lane",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:native": "tsc --noEmit && vite build --mode native",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:android": "npm run android:sync && node scripts/verify-native-bundle.mjs && cd android && ./gradlew test lintDebug assembleDebug assembleDebugAndroidTest --no-daemon",
    "test:android:instrumentation": "cd android && ./gradlew assembleDebugAndroidTest --no-daemon",
    "android:sync": "npm run build:native && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@capacitor/cli": "^7.4.3",
    "@playwright/test": "1.58.2",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "playwright-core": "1.58.2"
  }
}
